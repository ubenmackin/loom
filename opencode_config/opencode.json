{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "planner",
  "mcp": {
    "loom": {
      "type": "local",
      "_comment": "Loom MCP server. The paths below are environment-specific and intentionally NOT hardcoded to a developer's home directory. Replace them with the location of your local Loom checkout: (1) command[0] is the path to the built loom-server binary (often $LOOM_CHECKOUT/dist/loom-server), and (2) --db-path is the path to the loom SQLite database (often $LOOM_CHECKOUT/loom.db). opencode does not expand env variables in command arrays, so use literal absolute or relative paths resolved against the directory you spawn opencode from.",
      "command": [
        "./dist/loom-server",
        "--mcp",
        "--db-path",
        "./loom.db"
      ],
      "enabled": true
    }
  },
  "plugin": [
    "@tarquinen/opencode-dcp@latest"
  ],
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "todoread": "deny",
    "todowrite": "deny"
  },
  "agent": {
    "plan": {
      "disable": true,
      "options": {},
      "permission": {}
    },
    "build": {
      "disable": true,
      "options": {},
      "permission": {}
    },
    "general": {
      "disable": true,
      "options": {},
      "permission": {}
    },
    "explore": {
      "disable": true,
      "options": {},
      "permission": {}
    },
    "planner": {
      "mode": "primary",
      "color": "#4dabf7",
      "description": "Lead Architect responsible for codebase analysis and creating execution blueprints.",
      "_comment": "Read-only planner. Reads the filesystem via the global 'read' permission and inspects repo structure via architect_* tools; interacts with the Loom board via MCP. bash and edit are deny — the planner never executes shell commands or mutates source.",
      "prompt": "{file:./prompts/planner.txt}",
      "permission": {
        "skill": {
          "*": "deny",
          "find_pattern": "allow"
        },
        "task": {
          "*": "deny",
          "orchestrator": "allow",
          "git-manager": "ask"
        },
        "architect_map_workspace": "allow",
        "architect_summarize_structure": "allow",
        "register_session": "allow",
        "create_task": "allow",
        "add_dependency": "allow",
        "report_blocked": "allow",
        "get_story": "allow",
        "get_comments": "allow",
        "get_task": "allow",
        "get_blockers": "allow",
        "bash": "deny",
        "edit": "deny"
      },
      "options": {}
    },
    "orchestrator": {
      "mode": "all",
      "color": "#be4bdb",
      "description": "Factory Manager: Pipeline coordination and state updates.",
      "prompt": "{file:./prompts/orchestrator.txt}",
      "permission": {
        "skill": {
          "*": "deny",
          "find_pattern": "allow"
        },
        "task": {
          "*": "deny",
          "executor": "allow",
          "builder": "allow",
          "reviewer": "allow"
        },
        "architect_map_workspace": "allow",
        "architect_summarize_structure": "allow",
        "register_session": "allow",
        "get_task": "allow",
        "get_blockers": "allow",
        "get_comments": "allow",
        "add_comment": "allow",
        "get_unread_comments": "allow",
        "bash": "deny",
        "edit": "deny",
        "google_search": "deny",
        "webfetch": "deny"
      },
      "options": {}
    },
    "executor": {
      "mode": "all",
      "color": "#ff922b",
      "description": "Lead Developer: Code implementation.",
      "prompt": "{file:./prompts/executor.txt}",
      "permission": {
        "skill": "allow",
        "task": "deny",
        "bash": {
          "*": "deny",
          "mkdir *": "allow",
          "mv *": "allow",
          "cp *": "allow",
          "cat *": "allow",
          "grep *": "allow",
          "rg *": "allow",
          "find *": "allow",
          "chmod *": "allow"
        },
        "edit": "allow",
        "google_search": "deny",
        "webfetch": "allow",
        "architect_map_workspace": "allow",
        "architect_summarize_structure": "allow",
        "register_session": "allow",
        "request_work": "allow",
        "start_work": "allow",
        "complete_work": "allow",
        "report_blocked": "allow",
        "keep_alive": "allow",
        "get_task": "allow",
        "get_blockers": "allow",
        "add_comment": "allow",
        "get_comments": "allow",
        "memory_list": "deny",
        "memory_set": "deny",
        "memory_replace": "deny"
      },
      "options": {}
    },
    "builder": {
      "mode": "all",
      "color": "#51cf66",
      "description": "Build Engineer: Verification and syntax fixes.",
      "prompt": "{file:./prompts/builder.txt}",
      "_comment": "Builder uses a narrow bash allowlist (build/test/lint commands only) with edit denied. opencode's permission model supports this granularity, so the narrow form is preferred over granting full edit. If a project ever requires the builder to patch source to fix syntax errors, flip 'edit' to 'allow' here.",
      "permission": {
        "skill": "allow",
        "task": "deny",
        "bash": {
          "*": "deny",
          "echo $?": "allow",
          "tail *": "allow",
          "head *": "allow",
          "npm ci *": "allow",
          "npm install *": "allow",
          "npm run *": "allow",
          "npm test *": "allow",
          "npx tsc *": "allow",
          "make *": "allow",
          "grep *": "allow",
          "rg *": "allow",
          "go mod tidy *": "allow",
          "go vet *": "allow",
          "go build *": "allow",
          "go test *": "allow",
          "gofmt *": "allow",
          "golangci-lint *": "allow",
          "xcodebuild *": "allow",
          "xcodegen *": "allow"
        },
        "edit": "deny",
        "google_search": "deny",
        "webfetch": "deny",
        "architect_map_workspace": "allow",
        "architect_summarize_structure": "allow",
        "register_session": "allow",
        "request_work": "allow",
        "start_work": "allow",
        "complete_work": "allow",
        "report_blocked": "allow",
        "keep_alive": "allow",
        "create_task": "allow",
        "get_task": "allow",
        "add_comment": "allow",
        "memory_list": "deny",
        "memory_set": "deny",
        "memory_replace": "deny"
      },
      "options": {}
    },
    "reviewer": {
      "mode": "all",
      "color": "#ff6b6b",
      "description": "Senior Reviewer: Architecture audit.",
      "prompt": "{file:./prompts/reviewer.txt}",
      "permission": {
        "skill": "allow",
        "task": "deny",
        "bash": "deny",
        "edit": "deny",
        "architect_map_workspace": "allow",
        "architect_summarize_structure": "allow",
        "register_session": "allow",
        "request_work": "allow",
        "start_work": "allow",
        "complete_work": "allow",
        "report_blocked": "allow",
        "keep_alive": "allow",
        "create_task": "allow",
        "get_task": "allow",
        "add_comment": "allow",
        "memory_list": "deny",
        "memory_set": "deny",
        "memory_replace": "deny"
      },
      "options": {}
    },
    "security-auditor": {
      "mode": "all",
      "color": "#f06595",
      "description": "Security Auditor: Vulnerability scanning and credential leak detection.",
      "prompt": "{file:./prompts/security-auditor.txt}",
      "_comment": "Scan-only posture. opencode does not expose a per-tool allowlist primitive separate from the bash glob map; the bash glob map below is the allowlist. 'edit' is deny and 'webfetch'/'google_search' are deny so the auditor cannot reshape code or phone home. Add scanner binaries (e.g. 'grype *', 'trivy *', 'gitleaks *') to the bash allowlist as they become available.",
      "permission": {
        "skill": "allow",
        "task": "deny",
        "bash": {
          "*": "deny",
          "govulncheck *": "allow",
          "npm audit *": "allow",
          "grep *": "allow",
          "rg *": "allow",
          "find *": "allow",
          "grype *": "allow",
          "trivy *": "allow",
          "gitleaks *": "allow"
        },
        "edit": "deny",
        "google_search": "deny",
        "webfetch": "deny",
        "register_session": "allow",
        "request_work": "allow",
        "start_work": "allow",
        "complete_work": "allow",
        "report_blocked": "allow",
        "create_task": "allow",
        "keep_alive": "allow",
        "get_task": "allow",
        "add_comment": "allow"
      },
      "options": {}
    },
    "release-manager": {
      "mode": "all",
      "color": "#20c997",
      "description": "Release Manager: Commit, push, and create PRs.",
      "prompt": "{file:./prompts/release-manager.txt}",
      "_comment": "The release path mutates the repo. edit is 'allow' so release-manager can write PR body, CHANGELOG entries, and similar release artifacts. bash is narrowed to git + gh operations; general bash is denied.",
      "permission": {
        "skill": "allow",
        "task": "deny",
        "bash": {
          "*": "deny",
          "git status": "allow",
          "git add *": "allow",
          "git commit *": "allow",
          "git push origin feature/*": "allow",
          "gh pr *": "allow",
          "git worktree *": "allow"
        },
        "edit": "allow",
        "google_search": "deny",
        "webfetch": "deny",
        "register_session": "allow",
        "request_work": "allow",
        "start_work": "allow",
        "complete_work": "allow",
        "report_blocked": "allow",
        "keep_alive": "allow",
        "get_task": "allow",
        "add_comment": "allow"
      },
      "options": {}
    },
    "workspace-setup": {
      "mode": "all",
      "color": "#7950f2",
      "description": "Workspace Setup: Git worktree isolation for executor sessions.",
      "prompt": "{file:./prompts/workspace-setup.txt}",
      "_comment": "Scoped to worktree/boot operations. edit is 'allow' so workspace-setup can write files into the new worktree dir during boot (e.g. session markers, branch context files). bash is narrowed to git worktree, branch checkout, and mkdir.",
      "permission": {
        "skill": "allow",
        "task": "deny",
        "bash": {
          "*": "deny",
          "git worktree add *": "allow",
          "git checkout -b *": "allow",
          "mkdir *": "allow",
          "git status": "allow"
        },
        "edit": "allow",
        "google_search": "deny",
        "webfetch": "deny",
        "register_session": "allow",
        "request_work": "allow",
        "start_work": "allow",
        "complete_work": "allow",
        "report_blocked": "allow",
        "keep_alive": "allow",
        "get_task": "allow",
        "add_comment": "allow"
      },
      "options": {}
    },
    "git-manager": {
      "mode": "all",
      "color": "#20c997",
      "description": "Git Specialist: Commits and branching.",
      "prompt": "{file:./prompts/git-manager.txt}",
      "_comment": "Git-only command shell. bash is narrowed to 'git *' (with push/reset gated to 'ask' for human confirmation). 'cat *' is intentionally NOT granted — git-manager may not read arbitrary files outside git operations; it relies on the global 'read' permission for fs inspection. edit is deny; release-manager owns repo-mutating writes.",
      "permission": {
        "skill": "allow",
        "task": "deny",
        "bash": {
          "*": "deny",
          "git *": "allow",
          "git push*": "ask",
          "git reset*": "ask"
        },
        "edit": "deny",
        "google_search": "deny",
        "webfetch": "deny",
        "register_session": "allow",
        "get_task": "allow",
        "memory_list": "deny",
        "memory_set": "deny",
        "memory_replace": "deny"
      },
      "options": {}
    }
  },
  "provider": {
    "macbook-llama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "macBook Llama",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "gemma4:e2b": {
          "name": "gemma4:e2b",
          "limit": {
            "context": 131072,
            "output": 131072
          },
          "tool_call": true
        }
      }
    },
    "local-llama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Llama",
      "options": {
        "baseURL": "http://nas.int.volcrypt.com:11434/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "gemma-4-26B-A4B-it-UD-Q5_K_M": {
          "name": "gemma-4-26B-A4B-it-UD-Q5_K_M",
          "limit": {
            "context": 131072,
            "output": 131072
          },
          "tool_call": true
        }
      }
    }
  },
  "server": {
    "port": 56789,
    "hostname": "0.0.0.0",
    "cors": [
      "https://code.int.volcrypt.com"
    ]
  }
}
